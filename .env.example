# Firebase Configuration Template
# Copy this to .env and fill in your values
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Audiomack API Configuration
AUDIOMACK_API_KEY=

# Audius uses its public discovery API; no API key is required.
# Optional: set this to the reachable base URL of the Express audio proxy.
# Use your computer's LAN IP when testing on a physical phone.
AUDIO_API_BASE_URL=

# MusicAPI Core (server-side credentials only)
# The MusicAPI account slug is public. Never put the Client Secret in the app.
MUSICAPI_ACCOUNT_SLUG=
MUSICAPI_CLIENT_ID=
MUSICAPI_CLIENT_SECRET=
# Generate a random secret of at least 32 characters for signing app-bound connections.
MUSICAPI_SESSION_SECRET=

# Google Sign-In Configuration
# Get your Web Client ID from Firebase Console -> Authentication -> Sign-in method -> Google (or Google Cloud Credentials)
GOOGLE_WEB_CLIENT_ID=
# Optional iOS OAuth client ID from Google Cloud Console
GOOGLE_IOS_CLIENT_ID=

# Gemini recommendations (backend .env only; never bundle this key in the mobile app)
GEMINI_API_KEY=
# Optional; used only when this model is listed as available to the backend API key
GEMINI_MODEL=
