rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents: only authenticated users can read, create, and update their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for everything else to enforce maximum security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
